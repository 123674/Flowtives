// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserDB {
  userID                      String     @id @default(uuid())
  event                       EventsDB[]
  userProfileLoc              String?
  userNameEncrypted           String
  userNameEncryptedIv         String
  userNameEncryptedAuthTag    String
  userNameEncryptedKeyVersion Int
  emailEncrypted              String
  emailEncryptedIv            String
  emailEncryptedAuthTag       String
  emailEncryptedKeyVersion    Int
  emailBlindIndex             String
  passwordHashed              String
}

model EventsDB {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime @db.Timestamptz(3)
  endTime     DateTime @db.Timestamptz(3)
  color       String
  userId      String
  user        UserDB   @relation(fields: [userId], references: [userID])
}
